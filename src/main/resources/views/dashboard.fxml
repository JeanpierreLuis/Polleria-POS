<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0"
            prefWidth="1300.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.restaurantPos.controllers.DashboardController">

    <left>
        <VBox spacing="12" styleClass="sidebar">

            <padding>
                <Insets bottom="24" left="18" right="18" top="24" />
            </padding>

            <VBox spacing="2" styleClass="brand">
                <Label styleClass="logo" text="POLLERÍA POS" />
                <Label styleClass="logo-subtitle" text="Panel operativo" />
            </VBox>

            <Button id="activeMenuButton" onAction="#btnDashboard" styleClass="menu-button" text="Dashboard" />

            <Button onAction="#btnPedidos" styleClass="menu-button" text="Pedidos" />

            <Button onAction="#btnCaja" styleClass="menu-button" text="Caja" />

            <Button onAction="#btnProductos" styleClass="menu-button" text="Productos" />

            <Button onAction="#btnUsuarios" styleClass="menu-button" text="Usuarios" />

            <Button onAction="#btnReportes" styleClass="menu-button" text="Reportes" />

            <Region VBox.vgrow="ALWAYS" />

            <Label styleClass="sidebar-footer" text="Restaurant POS" />

        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header">

            <padding>
                <Insets bottom="18" left="28" right="28" top="18" />
            </padding>

            <VBox spacing="2">
                <Label styleClass="header-title" text="Dashboard" />
                <Label styleClass="header-subtitle" text="Resumen del día" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label styleClass="user-pill" text="Administrador" />

        </HBox>
    </top>

    <center>

        <VBox spacing="26" styleClass="content">

            <padding>
                <Insets bottom="28" left="28" right="28" top="28" />
            </padding>

            <HBox spacing="20">

                <VBox styleClass="card">
                    <Label styleClass="card-title" text="Ventas Hoy" />
                    <Label styleClass="card-value" text="S/ 1,250.00" />
                    <Label styleClass="card-caption" text="Caja principal" />
                </VBox>

                <VBox styleClass="card">
                    <Label styleClass="card-title" text="Pedidos Pendientes" />
                    <Label styleClass="card-value" text="15" />
                    <Label styleClass="card-caption" text="Por atender" />
                </VBox>

                <VBox styleClass="card">
                    <Label styleClass="card-title" text="Clientes" />
                    <Label styleClass="card-value" text="87" />
                    <Label styleClass="card-caption" text="Registrados" />
                </VBox>

                <VBox styleClass="card">
                    <Label styleClass="card-title" text="Productos" />
                    <Label styleClass="card-value" text="120" />
                    <Label styleClass="card-caption" text="En catálogo" />
                </VBox>

            </HBox>

            <Label styleClass="section-title" text="Accesos rápidos" />

            <HBox spacing="20">

                <Button onAction="#btnPedidoPrincipal" styleClass="action-button" text="Nuevo Pedido" />

                <Button onAction="#btnCajaPrincipal" styleClass="action-button" text="Abrir Caja" />

                <Button onAction="#btnProductoPrincipal" styleClass="action-button" text="Registrar Producto" />

                <Button onAction="#btnReportesPrincipal" styleClass="action-button" text="Ver Reportes" />

            </HBox>

        </VBox>

    </center>

</BorderPane>
