<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.restaurantPos.controllers.OrdersController">

    <!-- HEADER -->
    <top>
        <VBox spacing="10">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Label text="Gestión de Pedidos"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <HBox spacing="15">

                <Label text="Mesa:"/>
                <ComboBox fx:id="cbMesa" prefWidth="150"/>

                <Label text="Tipo Pedido:"/>
                <ComboBox fx:id="cbTipoPedido" prefWidth="150"/>

                <Label text="Cliente:"/>
                <TextField fx:id="txtCliente"
                           promptText="Nombre del cliente"
                           prefWidth="250"/>

            </HBox>

            <HBox spacing="10">

                <TextField fx:id="txtBuscarProducto"
                           promptText="Buscar producto..."
                           prefWidth="350"/>

                <Button text="Buscar"/>

            </HBox>

        </VBox>
    </top>

    <!-- CENTRO -->
    <center>

        <SplitPane dividerPositions="0.4">

            <!-- PRODUCTOS -->
            <VBox spacing="10">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Productos"
                       style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                <TableView fx:id="tblProductos">

                    <columns>

                        <TableColumn fx:id="colProductoNombre"
                                     text="Producto"
                                     prefWidth="220"/>

                        <TableColumn fx:id="colProductoPrecio"
                                     text="Precio"
                                     prefWidth="100"/>

                    </columns>

                </TableView>

                <Button text="Agregar al Pedido"
                        maxWidth="Infinity"/>

            </VBox>

            <!-- DETALLE -->
            <VBox spacing="10">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Detalle del Pedido"
                       style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                <TableView fx:id="tblDetalle">

                    <columns>

                        <TableColumn fx:id="colDetalleProducto"
                                     text="Producto"
                                     prefWidth="220"/>

                        <TableColumn fx:id="colDetalleCantidad"
                                     text="Cantidad"
                                     prefWidth="90"/>

                        <TableColumn fx:id="colDetallePrecio"
                                     text="Precio"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colDetalleSubtotal"
                                     text="Subtotal"
                                     prefWidth="120"/>

                    </columns>

                </TableView>

                <HBox spacing="15">

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="TOTAL:"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <Label fx:id="lblTotal"
                           text="S/ 0.00"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                </HBox>

            </VBox>

        </SplitPane>

    </center>

    <!-- FOOTER -->
    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button text="Quitar Producto"
                    fx:id="btnQuitarProducto"/>

            <Button text="Limpiar Pedido"
                    fx:id="btnLimpiarPedido"/>

            <Button text="Registrar Pedido"
                    fx:id="btnRegistrarPedido"/>

        </HBox>

    </bottom>

</BorderPane>